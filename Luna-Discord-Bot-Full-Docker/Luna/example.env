DISCORD_TOKEN=
LM_STUDIO_URL=http://127.0.0.1:1234/api/v1/chat
KOKORO_URL=http://localhost:8880/v1/audio/speech
KOKORO_VOICE=af_heart

# Text-to-speech provider: kokoro (default, local), qwen3 (local, Apple
# Silicon only, a cloned voice — scripts/qwen3-tts-metal.sh) or elevenlabs
# (cloud, paid). When the provider runs out of credits, is misconfigured, or
# fails, Luna falls back to TTS_FALLBACK and then to Kokoro, so keep Kokoro
# running. TTS_FALLBACK=none disables the fallback.
TTS_PROVIDER=kokoro
#TTS_FALLBACK=kokoro
# Qwen3-TTS: URL set by docker-compose.metal.yml; outside Docker use
# http://localhost:8890/v1/audio/speech. Unset voice = the server's default.
# QWEN3_TTS_STREAM=true plays sentences while they render: no pauses, but it
# stutters whenever rendering falls behind (e.g. while the LLM generates).
#QWEN3_TTS_URL=
#QWEN3_TTS_VOICE=luna
#QWEN3_TTS_STREAM=false
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# eleven_v4_turbo (default) follows audio tags like [laughs] and [whispers];
# eleven_flash_v2_5 is faster but ignores them.
#ELEVENLABS_MODEL=eleven_v4_turbo
# Let the LLM add audio tags while an expressive ElevenLabs model is speaking.
# Never applies to Kokoro, which has tags stripped instead.
#TTS_EXPRESSIVE=true
# How long to skip ElevenLabs after running out of credits (default 12 h),
# and after a key/voice/plan error (default 30 min).
#TTS_CREDITS_RETRY_MS=43200000
#TTS_PROVIDER_RETRY_MS=1800000

# Set by docker-compose; required when running outside Docker. Comma-separate
# several servers to round-robin between them.
WHISPER_SERVER_URLS=http://localhost:8081/inference
LM_STUDIO_MCP_BEARER_TOKEN=
TAVILY_API_KEY=
IGNORED_USER_IDS=
OWW_MODEL_PATH=/app/hey_luna.onnx
OWW_THRESHOLD=0.04
# Utterances peaking at/above this without a full detection are transcribed and
# kept only if Whisper hears "Luna" (two-stage detection; 0 = off).
#OWW_CANDIDATE_THRESHOLD=0.1
ENERGY_THRESHOLD=175
OWW_DEBUG_SCORE=0.05
#OWW_DEBUG_SCORE=0.000001
#OWW_MODEL_PATH=/app/hey_jarvis_v0.1.onnx
# Audio kept from before the energy gate opens and prepended to the utterance,
# so quiet word onsets are not clipped off before Whisper sees them. 0 disables.
PREROLL_MS=320

# Per-speaker LLM conversation memory. Both caps bound prefill cost, which grows
# with the chain and makes every turn slower than the last if left unbounded.
LM_MEMORY_TTL_MS=600000
LM_MEMORY_MAX_TURNS=12

# Luna's character: "You are Luna, a <LM_PERSONALITY> voice assistant…", and
# whether to ask for concise answers.
#LM_PERSONALITY=helpful
#LM_CONCISE=true

# if you want to interject some personality on occasion, set these, or omit them for nothing
LM_FLAVOR_PROMPT=Work in a brief, dry aside about Del Taco or pizza.
LM_FLAVOR_CHANCE=0.15

# Announce and greet people who join Luna's voice channel. Each person is
# greeted at most once per cooldown (default 10 min), and only if they are
# still in the channel after the delay.
GREET_ON_JOIN=true
GREET_COOLDOWN_MS=600000
GREET_DELAY_MS=1500

# Announce people who leave Luna's voice channel. Skipped if they are back
# within the delay (a dropped connection), and at most once per cooldown.
ANNOUNCE_LEAVE=true
LEAVE_COOLDOWN_MS=600000
LEAVE_DELAY_MS=3000

# Custom wording for the announcements above: phrases separated by |, with
# {name} where the person's name goes. One is picked at random each time.
# Leave unset to use the built-in lines.
#GREET_PHRASES={name} just joined. Hey {name}!|Welcome in, {name}!
#FAREWELL_PHRASES={name} just left. Bye, {name}!|And {name} is gone.

# Luna introduces herself when she joins a voice channel. INTRO_PHRASES takes
# | separated phrases like the ones above, with {wake} for the wake phrase.
ANNOUNCE_SELF=true
#INTRO_PHRASES=Hi everyone, Luna here! Say {wake} whenever you need me.

# Web search (needs TAVILY_API_KEY): always = offered on every question and the
# model decides when to search (default); keywords = only when keyword rules
# match; off = never.
#WEB_SEARCH=always
# Use an MCP server configured in LM Studio's mcp.json instead (LM Studio keeps
# it connected; ~1 s faster per question). TAVILY_API_KEY isn't needed then.
#SEARCH_MCP_PLUGIN=mcp/tavily
# Tools the model may use (comma-separated, or "all").
#SEARCH_TOOLS=tavily_search
# If the search server can't be reached: answer without it, pause search (ms).
#SEARCH_PAUSE_MS=300000

# Spoken heads-up when a web search starts.
# | separated; [tags] are performed by ElevenLabs v4 and dropped for Kokoro.
# Unset uses these built-in lines; ANNOUNCE_SEARCH=false turns it off.
#ANNOUNCE_SEARCH=true
#SEARCH_PHRASES=Let me search for that.|[curious] Hmm, let me take a look.|One sec, I'll check the web.|[thoughtful] Good question. Let me look that up.|Hang on, let me find out.

# "Still thinking" fillers when an answer is slow to start, until it starts
# (THINKING_MAX > 0 caps the count). THINKING_WAITS lists the random wait
# window in seconds for the 1st, 2nd, ... filler; the last window repeats. | separated; {name} is the asker's
# name, so phrases with it make some fillers personal. Unset uses these
# built-in lines; ANNOUNCE_THINKING=false turns it off.
#ANNOUNCE_THINKING=true
#THINKING_WAITS=15-22,22-30,30-40
#THINKING_MAX=0
#THINKING_PHRASES=Still thinking.|[thoughtful] Hmm, give me a moment.|Almost there, bear with me.|This one's taking a bit. Hang tight.|Just a little longer.|Hey {name}, I'm still working on that. I didn't forget about you.|Still on it, {name}. Thanks for your patience.

# Reasoning level for the LLM: off, low, medium, ... as the model allows.
# Unset uses the model's default (for qwen3.8-27b that is its maximum, xhigh).
#LLM_REASONING=
# If the model reasons this long before the answer starts (searching and
# reading results don't count), Luna asks again with reasoning off and says
# one of QUICK_ANSWER_PHRASES. 0 disables.
#LLM_THINK_LIMIT_MS=60000
#QUICK_ANSWER_PHRASES=Sorry, I was overthinking that one. Here's the quick answer.|Okay, let me give you the short version.

# Time zone used to tell the model today's date (IANA name). The container
# runs in UTC, so without this "today" flips to tomorrow in the evening.
#LUNA_TIMEZONE=America/Los_Angeles

# Discord voice is end-to-end encrypted; occasionally Luna's session loses one
# speaker's keys and hears nothing from them. If Discord reports someone
# speaking but none of their audio decrypts for this long, Luna reconnects
# (at most every 5 minutes). 0 disables.
#VOICE_RECOVER_MS=20000
